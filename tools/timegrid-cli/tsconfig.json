{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "isolatedModules": false,
    "baseUrl": ".",
    "paths": {
      "@timegrid/task-core": ["../../src/utils/taskParser.ts"],
      "@timegrid/task-types": ["../../src/types/task.ts"]
    }
  },
  "include": ["src/**/*.ts", "../../src/utils/taskParser.ts", "../../src/types/task.ts", "../../src/utils/routineMarker.ts"]
}
