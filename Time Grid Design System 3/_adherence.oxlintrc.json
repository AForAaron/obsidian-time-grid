{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/Button/**",
              "components/core/Icon/**",
              "components/core/StatCard/**",
              "components/modules/DailyPieChart/**",
              "components/modules/DayGrid/**",
              "components/modules/HourGrid/**",
              "components/modules/MonthHeatmap/**",
              "components/modules/SectionHeader/**",
              "components/modules/SuggestionChips/**",
              "components/modules/TaskCard/**",
              "components/modules/TimeHeatmap/**",
              "components/modules/TimerPanel/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|icon|children|onClick|disabled|type|ariaLabel|fullWidth|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, icon, children, onClick, disabled, type, ariaLabel, fullWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DailyPieBucket'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|durationMs|isRunning|key|ref|className|style|children)$/]",
        "message": "<DailyPieBucket> doesn't accept that prop. Declared props: name, durationMs, isRunning."
      },
      {
        "selector": "JSXOpeningElement[name.name='DayGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:now|key|ref|className|style|children)$/]",
        "message": "<DayGrid> doesn't accept that prop. Declared props: now."
      },
      {
        "selector": "JSXOpeningElement[name.name='HourGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:now|key|ref|className|style|children)$/]",
        "message": "<HourGrid> doesn't accept that prop. Declared props: now."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:month|day|hour|pie|chevronLeft|chevronRight)$/]",
        "message": "<Icon> name must be one of 'month' | 'day' | 'hour' | 'pie' | 'chevronLeft' | 'chevronRight'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MonthHeatmap'] > JSXAttribute > JSXIdentifier[name!=/^(?:now|key|ref|className|style|children)$/]",
        "message": "<MonthHeatmap> doesn't accept that prop. Declared props: now."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|subtitle|count|matchCount|fixed|collapsed|onToggle|accentColor|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: icon, title, subtitle, count, matchCount, fixed, collapsed, onToggle, accentColor."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|value|label|accentColor|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: icon, value, label, accentColor."
      },
      {
        "selector": "JSXOpeningElement[name.name='SuggestionChips'] > JSXAttribute > JSXIdentifier[name!=/^(?:recent|tasks|routines|onPick|key|ref|className|style|children)$/]",
        "message": "<SuggestionChips> doesn't accept that prop. Declared props: recent, tasks, routines, onPick."
      },
      {
        "selector": "JSXOpeningElement[name.name='TaskCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|status|accentColor|dueDate|overdue|priority|readonly|readonlyReason|sourceFile|writing|onToggle|onMore|onTitleClick|onEdit|onPostpone|key|ref|className|style|children)$/]",
        "message": "<TaskCard> doesn't accept that prop. Declared props: title, status, accentColor, dueDate, overdue, priority, readonly, readonlyReason, sourceFile, writing, onToggle, onMore, onTitleClick, onEdit, onPostpone."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimeHeatmap'] > JSXAttribute > JSXIdentifier[name!=/^(?:now|weeks|key|ref|className|style|children)$/]",
        "message": "<TimeHeatmap> doesn't accept that prop. Declared props: now, weeks."
      },
      {
        "selector": "JSXOpeningElement[name.name='RecoveryDay'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|role|key|ref|className|style|children)$/]",
        "message": "<RecoveryDay> doesn't accept that prop. Declared props: label, role."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
